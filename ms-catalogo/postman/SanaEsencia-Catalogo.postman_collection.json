{
  "info": {
    "name": "SanaEsencia - ms-catalogo",
    "description": "CRUD de servicios y especialistas. Completar variables de credenciales antes de ejecutar. La suite crea registros E2E y los deja inactivos; importa el catálogo sin sobrescribir perfiles existentes.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8081"
    },
    {
      "key": "adminEmail",
      "value": "admin.prueba@example.com"
    },
    {
      "key": "adminPassword",
      "value": "",
      "type": "string"
    },
    {
      "key": "pacienteEmail",
      "value": "paciente.prueba@example.com"
    },
    {
      "key": "pacientePassword",
      "value": "",
      "type": "string"
    },
    {
      "key": "servicioId",
      "value": "1"
    },
    {
      "key": "especialistaId",
      "value": "1"
    }
  ],
  "item": [
    {
      "name": "Suite completa - ejecutar con ambos microservicios activos",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/servicios",
        "auth": {
          "type": "noauth"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// Suite local: requiere usuarios (8080) y catálogo (8081).",
              "// Usa variables de Postman; no guardes contraseñas reales en el repositorio.",
              "const base = pm.variables.get(\"baseUrl\") || \"http://localhost:8081\";",
              "const adminEmail = pm.variables.get(\"adminEmail\");",
              "const adminPassword = pm.variables.get(\"adminPassword\");",
              "const pacienteEmail = pm.variables.get(\"pacienteEmail\");",
              "const pacientePassword = pm.variables.get(\"pacientePassword\");",
              "pm.test(\"Consulta inicial pública\", () => pm.response.to.have.status(200));",
              "if (!adminEmail || !adminPassword || !pacienteEmail || !pacientePassword) {",
              "    pm.test(\"Variables de credenciales configuradas\", () => {",
              "        throw Error(\"Configura adminEmail, adminPassword, pacienteEmail y pacientePassword\");",
              "    });",
              "} else {",
              "    const Buffer = require(\"buffer\").Buffer;",
              "    const basic = (email, password) => \"Basic \" + Buffer.from(email + \":\" + password).toString(\"base64\");",
              "    const admin = basic(adminEmail, adminPassword);",
              "    const paciente = basic(pacienteEmail, pacientePassword);",
              "    const marca = Date.now().toString();",
              "    const nombre = \"E2E Servicio \" + marca;",
              "    const nombreEspecialista = \"E2E Especialista \" + marca;",
              "    const normal = {nombre, descripcion: \"Registro temporal de pruebas de Postman\",",
              "        precio: 30000, duracionMinutos: 60, permiteOnline: true};",
              "    async function enviar(titulo, method, path, esperado, body, authorization) {",
              "        const request = {url: base + path, method, header: {}};",
              "        if (authorization) request.header.Authorization = authorization;",
              "        if (body !== undefined) {",
              "            request.header[\"Content-Type\"] = \"application/json\";",
              "            request.body = {mode: \"raw\", raw: typeof body === \"string\" ? body : JSON.stringify(body)};",
              "        }",
              "        const response = await pm.sendRequest(request);",
              "        pm.test(titulo + \" -> \" + esperado, () => pm.expect(response.code).to.equal(esperado));",
              "        return response;",
              "    }",
              "    const datos = response => response.json();",
              "    async function ejecutar() {",
              "        const creado = await enviar(\"Crear servicio como admin\", \"POST\", \"/api/servicios\", 201, normal, admin);",
              "        if (creado.code !== 201) return;",
              "        const id = datos(creado).id;",
              "        pm.test(\"Servicio con precio, duración y estado\", () => {",
              "            pm.expect(Number(datos(creado).precio)).to.equal(30000);",
              "            pm.expect(datos(creado).duracionMinutos).to.equal(60);",
              "            pm.expect(datos(creado).activo).to.equal(true);",
              "        });",
              "        await enviar(\"Consulta pública por ID\", \"GET\", \"/api/servicios/\" + id, 200);",
              "        await enviar(\"Servicio inexistente\", \"GET\", \"/api/servicios/9223372036854775807\", 404);",
              "        await enviar(\"ID inválido\", \"GET\", \"/api/servicios/no-numero\", 400);",
              "        await enviar(\"Nombre duplicado\", \"POST\", \"/api/servicios\", 409, normal, admin);",
              "        const invalidos = [",
              "            [\"Nombre vacío\", {nombre: \" \"}],",
              "            [\"Precio cero\", {precio: 0}],",
              "            [\"Precio negativo\", {precio: -1}],",
              "            [\"Más de dos decimales\", {precio: 30000.123}],",
              "            [\"Duración cero\", {duracionMinutos: 0}],",
              "            [\"Modalidad obligatoria\", {permiteOnline: null}]",
              "        ];",
              "        for (const [titulo, cambios] of invalidos) {",
              "            await enviar(titulo, \"POST\", \"/api/servicios\", 400, {...normal, ...cambios}, admin);",
              "        }",
              "        await enviar(\"JSON inválido\", \"POST\", \"/api/servicios\", 400, '{\"nombre\":', admin);",
              "        await enviar(\"Sin autenticación\", \"POST\", \"/api/servicios\", 401, normal);",
              "        await enviar(\"Password incorrecta\", \"POST\", \"/api/servicios\", 401, normal,",
              "            basic(adminEmail, \"Incorrecta-Postman\"));",
              "        await enviar(\"Paciente no puede crear\", \"POST\", \"/api/servicios\", 403, normal, paciente);",
              "        await enviar(\"Paciente no puede actualizar\", \"PUT\", \"/api/servicios/\" + id, 403, normal, paciente);",
              "        await enviar(\"Paciente no puede desactivar\", \"DELETE\", \"/api/servicios/\" + id, 403, undefined, paciente);",
              "        await enviar(\"Actualizar servicio\", \"PUT\", \"/api/servicios/\" + id, 200,",
              "            {...normal, descripcion: \"Descripción actualizada\"}, admin);",
              "        const cambio = await enviar(\"Verificar actualización persistida\", \"GET\", \"/api/servicios/\" + id, 200);",
              "        pm.test(\"La descripción quedó guardada\", () =>",
              "            pm.expect(datos(cambio).descripcion).to.equal(\"Descripción actualizada\"));",
              "        const perfil = {nombre: nombreEspecialista, especialidad: \"Psicología\",",
              "            descripcion: \"Perfil temporal de prueba\", permitePresencial: false,",
              "            permiteOnline: true, servicioIds: [id]};",
              "        const esp = await enviar(\"Crear especialista\", \"POST\", \"/api/especialistas\", 201, perfil, admin);",
              "        if (esp.code !== 201) return;",
              "        const eid = datos(esp).id;",
              "        pm.test(\"Especialista vinculado al servicio\", () => pm.expect(datos(esp).servicios[0].id).to.equal(id));",
              "        await enviar(\"Consultar especialista\", \"GET\", \"/api/especialistas/\" + eid, 200);",
              "        const filtro = await enviar(\"Filtrar especialistas por servicio\", \"GET\",",
              "            \"/api/especialistas?servicioId=\" + id, 200);",
              "        pm.test(\"El filtro incluye al especialista\", () => pm.expect(datos(filtro).some(e => e.id === eid)).to.equal(true));",
              "        await enviar(\"Especialista duplicado\", \"POST\", \"/api/especialistas\", 409, perfil, admin);",
              "        await enviar(\"Perfil sin modalidad\", \"POST\", \"/api/especialistas\", 400,",
              "            {...perfil, nombre: nombreEspecialista + \" inválido\", permiteOnline: false}, admin);",
              "        await enviar(\"Servicio relacionado inexistente\", \"POST\", \"/api/especialistas\", 404,",
              "            {...perfil, nombre: nombreEspecialista + \" sin servicio\", servicioIds: [9223372036854775]}, admin);",
              "        await enviar(\"Datos de especialista incompletos\", \"POST\", \"/api/especialistas\", 400, {}, admin);",
              "        await enviar(\"Paciente no crea especialistas\", \"POST\", \"/api/especialistas\", 403, perfil, paciente);",
              "        await enviar(\"Actualizar especialista\", \"PUT\", \"/api/especialistas/\" + eid, 200,",
              "            {...perfil, descripcion: \"Perfil actualizado\"}, admin);",
              "        await enviar(\"Proteger modalidad de especialista solo online\", \"PUT\", \"/api/servicios/\" + id,",
              "            409, {...normal, permiteOnline: false}, admin);",
              "        await enviar(\"Especialista inexistente\", \"GET\", \"/api/especialistas/9223372036854775807\", 404);",
              "        await enviar(\"Desactivar especialista de prueba\", \"DELETE\", \"/api/especialistas/\" + eid, 204, undefined, admin);",
              "        const sinEsp = await enviar(\"Listado no incluye especialista inactivo\", \"GET\", \"/api/especialistas\", 200);",
              "        pm.test(\"Especialista desactivado oculto del listado\", () =>",
              "            pm.expect(datos(sinEsp).some(e => e.id === eid)).to.equal(false));",
              "        await enviar(\"Reactivar especialista\", \"PATCH\", \"/api/especialistas/\" + eid + \"/estado\",",
              "            200, {activo: true}, admin);",
              "        await enviar(\"Desactivar servicio de prueba\", \"DELETE\", \"/api/servicios/\" + id, 204, undefined, admin);",
              "        const sinServicio = await enviar(\"Listado de servicios activos\", \"GET\", \"/api/servicios\", 200);",
              "        pm.test(\"Servicio desactivado oculto del listado\", () =>",
              "            pm.expect(datos(sinServicio).some(s => s.id === id)).to.equal(false));",
              "        const sinFiltro = await enviar(\"Sin especialistas reservables para servicio inactivo\", \"GET\",",
              "            \"/api/especialistas?servicioId=\" + id, 200);",
              "        pm.test(\"Filtro vacío para servicio inactivo\", () => pm.expect(datos(sinFiltro)).to.deep.equal([]));",
              "        await enviar(\"Volver a desactivar perfil de prueba\", \"DELETE\", \"/api/especialistas/\" + eid, 204, undefined, admin);",
              "        await enviar(\"No reactivar con servicios inactivos\", \"PATCH\",",
              "            \"/api/especialistas/\" + eid + \"/estado\", 409, {activo: true}, admin);",
              "        await enviar(\"Reactivar servicio\", \"PATCH\", \"/api/servicios/\" + id + \"/estado\", 200, {activo: true}, admin);",
              "        await enviar(\"Reactivación posterior permitida\", \"PATCH\",",
              "            \"/api/especialistas/\" + eid + \"/estado\", 200, {activo: true}, admin);",
              "        // Los registros E2E se conservan desactivados, sin borrar datos ni afectar el servicio original.",
              "        await enviar(\"Dejar especialista E2E inactivo\", \"DELETE\", \"/api/especialistas/\" + eid, 204, undefined, admin);",
              "        await enviar(\"Dejar servicio E2E inactivo\", \"DELETE\", \"/api/servicios/\" + id, 204, undefined, admin);",
              "        await enviar(\"Paciente no accede a administración\", \"GET\", \"/api/admin/catalogo/especialistas\",",
              "            403, undefined, paciente);",
              "        await enviar(\"Paciente no importa catálogo\", \"POST\", \"/api/admin/catalogo/importar-centro\",",
              "            403, undefined, paciente);",
              "        await enviar(\"Importar catálogo del centro\", \"POST\", \"/api/admin/catalogo/importar-centro\", 200, undefined, admin);",
              "        const repetida = await enviar(\"Repetir importación sin duplicados\", \"POST\",",
              "            \"/api/admin/catalogo/importar-centro\", 200, undefined, admin);",
              "        pm.test(\"Importación repetida crea cero registros\", () => {",
              "            pm.expect(datos(repetida).serviciosCreados).to.equal(0);",
              "            pm.expect(datos(repetida).especialistasCreados).to.equal(0);",
              "        });",
              "        const todos = await enviar(\"Administración incluye perfiles pausados\", \"GET\",",
              "            \"/api/admin/catalogo/especialistas\", 200, undefined, admin);",
              "        const reales = datos(todos).filter(e => !e.nombre.startsWith(\"E2E \"));",
              "        pm.test(\"Catálogo incluye 30 perfiles del centro\", () => pm.expect(reales.length).to.be.at.least(30));",
              "        pm.test(\"Perfiles pausados y solo online conservados\", () => {",
              "            pm.expect(reales.find(e => e.nombre === \"Nataly Godoy\").activo).to.equal(false);",
              "            const camila = reales.find(e => e.nombre === \"Dra. Camila Tabilo\");",
              "            pm.expect(camila.permitePresencial).to.equal(false);",
              "            pm.expect(camila.permiteOnline).to.equal(true);",
              "        });",
              "        const activos = await enviar(\"Listado público final\", \"GET\", \"/api/servicios\", 200);",
              "        pm.test(\"El catálogo del centro conserva precio y duración acordados\", () => {",
              "            const medicina = datos(activos).find(s => s.nombre === \"Medicina general y salud mental\");",
              "            pm.expect(Number(medicina.precio)).to.equal(30000);",
              "            pm.expect(medicina.duracionMinutos).to.equal(60);",
              "        });",
              "    }",
              "    ejecutar().catch(error => pm.test(\"Suite completada sin interrupciones\", () => { throw error; }));",
              "}",
              ""
            ]
          }
        }
      ]
    },
