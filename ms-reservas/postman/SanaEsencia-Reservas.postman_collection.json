          "request": {
            "method": "GET",
            "url": "{{reservasUrl}}/api/agenda/{{especialistaId}}",
            "auth": {
              "type": "basic",
              "basic": [
                {
                  "key": "username",
                  "value": "{{correo}}",
                  "type": "string"
                },
                {
                  "key": "password",
                  "value": "{{password}}",
                  "type": "string"
                }
              ]
            },
            "header": []
          }
        },
        {
          "name": "Configurar agenda propia o como admin",
          "request": {
            "method": "PUT",
            "url": "{{reservasUrl}}/api/agenda/{{especialistaId}}",
            "auth": {
              "type": "basic",
              "basic": [
                {
                  "key": "username",
                  "value": "{{correo}}",
                  "type": "string"
                },
                {
                  "key": "password",
                  "value": "{{password}}",
                  "type": "string"
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"horarios\": [\n    {\n      \"dia\": \"MONDAY\",\n      \"desde\": \"09:00\",\n      \"hasta\": \"18:00\"\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Ver horas disponibles",
          "request": {
            "method": "GET",
            "url": "{{reservasUrl}}/api/disponibilidad?especialistaId={{especialistaId}}&servicioId={{servicioId}}&fecha={{fecha}}&modalidad=PRESENCIAL",
            "auth": {
              "type": "basic",
              "basic": [
